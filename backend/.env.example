# Kopier denne filen til ".env" i backend/ og fyll inn din egen API-nøkkel.
# Filen ".env" skal ALDRI committes (den er allerede dekket av .gitignore).
# Demomodus ("GET /api/analyze/demo") krever ikke at disse er satt.

# API-nøkkel for OpenAI. Kreves for normalmodus ("POST /api/analyze").
OPENAI_API_KEY=

# Hvilken OpenAI-modell som brukes i normalmodus.
OPENAI_MODEL=gpt-5.4-mini

# Maks antall sekunder backenden venter på svar fra språkmodellen før den
# gir opp (ingen automatiske retries gjøres ved tidsavbrudd eller feil).
OPENAI_TIMEOUT_SECONDS=30
